{
  // Cloudflare Workers config for the Next.js app, built via the OpenNext
  // adapter (@opennextjs/cloudflare). `main` points at the worker the adapter
  // emits; static assets are served from the generated `.open-next/assets` dir.
  //
  // Deploy:  pnpm --filter @sync/web deploy
  // Preview: pnpm --filter @sync/web preview
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taruu-web",
  // Custom entry (worker.ts) re-exports the OpenNext fetch handler and adds the
  // scheduled handler that drives the cron routes - see triggers.crons below.
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  // nodejs_compat gives the full Node runtime the app relies on (supabase-js,
  // twilio, jose, resend, expo-server-sdk). Required by OpenNext.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Phone OTP store (one-time codes, native TTL). Create once with:
  //   wrangler kv namespace create OTP_KV
  // then paste the returned id below. Without it, OTP falls back to an
  // in-memory store (dev/test only - not viable across isolates in prod).
  "kv_namespaces": [
    { "binding": "OTP_KV", "id": "6f3f1d0e88df41d18773165a406b86b6" }
  ],

  // ISR / Data-Cache store for the OpenNext incremental cache (see
  // open-next.config.ts). The binding NAME is fixed by the adapter - do not
  // rename it. Create the bucket once with:
  //   wrangler r2 bucket create taruu-web-cache
  // Without this binding every `revalidate` route regenerates per isolate.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "taruu-web-cache" }
  ],

  "observability": {
    "enabled": true
  },

  // Custom-domain routes - Cloudflare creates the proxied DNS records on deploy.
  // Requires the taruu.co.il zone to be Active in this account.
  "routes": [
    { "pattern": "taruu.co.il", "custom_domain": true },
    { "pattern": "www.taruu.co.il", "custom_domain": true },
    { "pattern": "api.taruu.co.il", "custom_domain": true }
  ],

  // --- Custom domains ---
  // Do NOT add DNS records by hand. After the first deploy, attach the domains
  // in the dashboard (Workers > taruu-web > Domains & Routes > Add custom
  // domain) for taruu.co.il, www.taruu.co.il, api.taruu.co.il - Cloudflare
  // creates the proxied DNS records itself. The zone must be Active first.

  // --- Scheduled jobs ---
  // Cron Triggers fire worker.ts's scheduled handler, which POSTs the matching
  // HTTP cron route with the CRON_SECRET bearer. Schedules MUST match the keys
  // in CRON_ROUTES (worker.ts):
  //   */15 * * * *  → /api/cron/verification-notifications
  //   0 * * * *     → /api/cron/resolve-votes
  //   */10 * * * *  → /api/cron/mint-nfts
  //   0 */6 * * *   → /api/cron/knesset-agenda
  //   30 3 * * *    → /api/cron/knesset-roster
  //   20 */2 * * *  → /api/cron/knesset-rollcalls
  // Requires the CRON_SECRET secret to be set (wrangler secret put CRON_SECRET).
  // NOTE: the schedules API rejected these at deploy (account-level cron gate on
  // this account). worker.ts's scheduled handler IS deployed - add the four
  // crons in the dashboard (Workers > taruu-web > Settings > Triggers > Cron) or
  // re-enable here once cron triggers are available, then `wrangler triggers deploy`.
  // "triggers": {
  //   "crons": ["*/15 * * * *", "0 * * * *", "*/10 * * * *", "0 */6 * * *"]
  // },
  // Only the day-order sync is registered here. Document summaries moved to
  // agents/knesset-ranker (Agent SDK, no API key) - see docs/KNESSET.md.
  //
  // The two government-mirror crons are routed in worker.ts but deliberately
  // NOT listed below: this account's cron gate rejected a multi-schedule
  // deploy once already (see the note above), and adding them here would fail
  // the whole deploy rather than the one trigger. Add "30 3 * * *" and
  // "20 */2 * * *" in the dashboard (Workers > taruu-web > Settings >
  // Triggers > Cron), or move them into this array once the gate is lifted.
  "triggers": {
    "crons": ["0 */6 * * *"]
  },

  // Secrets are NOT stored here. Set them with `wrangler secret put <NAME>`
  // (or .dev.vars locally). Only NON-secret public vars belong in `vars`.
  "vars": {
    // Payments are OFF until the provider approves the account. Only the exact
    // string "true" turns money on, and the client reads it at BUILD time
    // (NEXT_PUBLIC_ inlining), so flipping it means a rebuild + deploy, not just
    // a var edit. GREENINVOICE_ENV below no longer gates the site: it selects
    // the provider's API host and nothing else.
    "NEXT_PUBLIC_PAYMENTS_ENABLED": "false",
    "GREENINVOICE_ENV": "production",
    "QUBIK_NETWORK": "mainnet",
    // Cutover for automatic activation of fully assembled discovery votes
    // (see docs/INGEST.md). Only ingest votes created at or after this instant
    // are eligible; the `pending` backlog that accumulated before it is out of
    // reach by construction, enforced inside `activate_ingest_vote` itself.
    //
    // A timestamp is not a credential, so it lives here rather than as a
    // `wrangler secret`. That is also what makes the deploy safe: a `vars`
    // entry ships atomically with the Worker, so there is no window between
    // the deploy and a manual `secret put` in which every ingest answers 503.
    //
    // Two constraints on any future edit:
    //   - must be at or after the moment 20260902000001_ingest_auto_activation
    //     was applied to production, or activation hits a missing function;
    //   - must be in the PAST relative to the Worker clock. `activationCutover()`
    //     refuses a future instant with 503 rather than creating votes it could
    //     never activate - so do NOT copy the migration's version number here,
    //     which is deliberately future-sorted and is not an apply time.
    "INGEST_AUTOACTIVATE_SINCE": "2026-08-19T09:19:52Z"
  }
}
