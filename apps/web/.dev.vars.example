# Local Workers secrets for `next dev` / `wrangler dev` (OpenNext).
# Copy to `.dev.vars` (gitignored) and fill. In production these are set with
# `wrangler secret put <NAME>` - NOT committed, NOT in wrangler.jsonc.
#
# Non-secret public vars (GREENINVOICE_ENV, QUBIK_NETWORK) live in
# wrangler.jsonc `vars` instead.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT sessions
JWT_SECRET=
JWT_EXPIRY=7d

# Auth kernel (issue #71) - HKDF master key for all session/refresh/OAuth-state/MFA keys; >=32 chars, hard-required (no fallback).
AUTH_MASTER_KEY=
# ISO-8601 instant closing the legacy JWT_SECRET session-token window (recommend deploy+30d); unset/invalid = closed, fail closed.
AUTH_LEGACY_UNTIL=
# HMAC pepper for security_events.ip_hash forensics; unset = ip_hash stored NULL (degradation is logged once per isolate).
SECURITY_EVENT_PEPPER=

# Taruu's own EC P-256 signing key, as a private JWK (RLS-01).
# Supabase verifies our short-lived ES256 access tokens against the JWKS we
# publish at /.well-known/jwks.json. We sign our own because this project
# migrated to asymmetric keys - there is no shared secret to borrow.
# Generate with: ./scripts/setup-supabase-third-party-auth.sh
# NOT the anon key, NOT the service_role key, NOT the same value as JWT_SECRET.
SUPABASE_TP_PRIVATE_JWK=

# Identity documents (issue #32) - HMAC key for one-way ID-number hashing.
# Falls back to JWT_SECRET when unset; set a dedicated secret in production.
IDENTITY_HASH_SECRET=


# Google OAuth (direct OIDC - primary login).
# Redirect URI registered on the client MUST be <app-url>/he/sign-in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook / Instagram OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Qubik blockchain
QUBIK_API_KEY=

# Payments kill switch. NOT a secret - public by construction (NEXT_PUBLIC_).
# ONLY the exact string `true` turns money on; absent/empty/anything else is OFF,
# which is the shipped default until the provider approves the account.
# While OFF: /api/payments/create, /api/payments/refund and /api/merch/checkout
# answer 503 PAYMENTS_DISABLED, and the GREENINVOICE_* entries below are not
# required by the runtime gate. Free voting is unaffected either way.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Green Invoice (Merchant of Record - vote fees + merch store)
GREENINVOICE_API_KEY_ID=
GREENINVOICE_API_SECRET=
GREENINVOICE_PLUGIN_ID=
GREENINVOICE_WEBHOOK_SECRET=

# bags.fm (BAGS) - private key is also the cNFT minter keypair
BAGS_API_KEY=
BAGS_WEBHOOK_SECRET=
BAGS_MASTER_WALLET_ADDRESS=
BAGS_MASTER_WALLET_PRIVATE_KEY=

# Solana compressed-NFT certificates (Bubblegum + Helius + Pinata)
SOLANA_RPC_URL=
SOLANA_MERKLE_TREE=
PINATA_JWT=

# Resend (transactional email)
RESEND_API_KEY=

# Phone OTP SMS delivery (codes are generated/verified in-app via Workers KV;
# this is only the SMS transport - any modern SMS REST API). Unset = mock-degrade.
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=

# Newsletter: no vendor keys. The list lives in Supabase
# (newsletter_subscribers), reached with SUPABASE_SERVICE_ROLE_KEY above.

# Expo push
EXPO_ACCESS_TOKEN=

# Upstash rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron auth (guards /api/cron/* - see DNS-SETUP.md "Cron")
CRON_SECRET=

# Discovery ingest auth - Bearer token for POST /api/ingest/topics (see docs/INGEST.md).
# Already set on the Worker; recorded here so the key is discoverable. Cloudflare
# secrets are write-only, so the live value cannot be read back out - if you need
# it locally, mint a new one and `wrangler secret put INGEST_SECRET`.
# NOTE: the ingest route's other variable, INGEST_AUTOACTIVATE_SINCE, is NOT a
# secret and does not belong here - it is a committed entry in wrangler.jsonc `vars`.
INGEST_SECRET=

# Optional — set to false to remove the space-admin dashboard routes and pages (issue #75). Defaults to on.
SPACE_ADMIN_ENABLED=true

# Pilot program — LLM copy drafting in the campaign desk (POST /api/pilot-admin/campaigns/[id]/draft-copy)
# Google AI Studio key for generativelanguage.googleapis.com. Optional: without
# it only the draft button fails, every other pilot surface is unaffected.
GEMINI_API_KEY=
# Optional override for the drafting model. Defaults to gemini-3.6-flash.
PILOT_COPY_MODEL=

# Pilot program — HMAC key for one-way click IP hashing (falls back to JWT_SECRET, like IDENTITY_HASH_SECRET)
CLICK_HASH_SECRET=

# Public app URLs
NEXT_PUBLIC_APP_URL=https://taruu.co.il
EXPO_PUBLIC_API_URL=https://api.taruu.co.il

# --- Ops tokens (machine/CI credentials - NEVER pushed to the worker; see SKIP
# in scripts/sync-secrets.sh). Pushed to GitHub Actions via sync-gh-secrets.sh.
CLOUDFLARE_API_TOKEN=
# Account the worker deploys into. The OpenNext adapter needs it explicitly to
# provision the R2 incremental-cache bucket; `wrangler whoami` shows the value.
CLOUDFLARE_ACCOUNT_ID=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
