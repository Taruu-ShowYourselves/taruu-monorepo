# ---- Supabase (service role — required by src/rank.ts) ----
# Falls back to apps/web/.env.local when running from the monorepo.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- VM agents space (deploy targets) ----
# Aliases resolve via ~/.ssh/config on the operator machine.
#
# hermes — Sahar's box (91.98.75.154, user sahar-admin, key ~/.ssh/hetzner_hermes;
#          also reachable as user handoff via alias "hetzner")
HERMES_SSH=hermes-admin
# dolev — taruu fleet node (159.69.249.191, user dolev, key ~/.ssh/dolev_hetzner_ed25519)
DOLEV_SSH=dolev-box

# Where scripts/deploy.sh ships and schedules the ranker.
DEPLOY_SSH=dolev-box
