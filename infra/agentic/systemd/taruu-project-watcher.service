[Unit]
Description=Taruu GitHub Project In Progress watcher
After=network-online.target taruu-openclaw.service
Wants=network-online.target

[Service]
Type=oneshot
User=taruu-agent
Group=taruu-agent
WorkingDirectory=/srv/taruu-agent/workspaces/orchestrator
Environment=HOME=/home/taruu-agent
Environment=PATH=/usr/bin:/usr/local/bin:/bin
EnvironmentFile=/etc/taruu-agent/agent.env
ExecStart=/usr/bin/node /opt/taruu-agent/scripts/watch-project.mjs
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/taruu-agent/project-watcher
