{
  "repo": "Taruu-ShowYourselves/taruu-monorepo",
  "board": { "owner": "Taruu-ShowYourselves", "projectNumber": 2 },
  "email": {
    "to": "sahar.h.barak@gmail.com",
    "from": "autopilot@updates.pleiad.ai",
    "subjectPrefix": "[taruu-autopilot]",
    "digestHourLocal": 8
  },
  "lanes": { "max": 2 },
  "budgets": {
    "specLapsMax": 2,
    "implLapsMax": 2,
    "changeRequestResetsMax": 1,
    "compactionsPerLapMax": 2,
    "coderTokensPerLap": 400000,
    "dailyCoderTokens": 2000000,
    "gateTimeoutHours": 12
  },
  "context": { "compactAtWindowPct": 40 },
  "models": {
    "researcher": { "seat": "codex", "model": "gpt-5.6-codex" },
    "planner": { "seat": "codex", "model": "gpt-5.6-codex" },
    "parser": { "seat": "codex", "model": "gpt-5.6-codex" },
    "coder": { "seat": "claude", "model": "claude-opus-5", "contextWindow": 200000 },
    "reviewer": { "seat": "codex", "model": "gpt-5.6-codex" }
  },
  "protectedPaths": [
    "supabase/migrations/",
    ".github/workflows/",
    "apps/web/src/app/api/payments/"
  ],
  "memoryAreas": ["web-api", "web-press", "mobile", "supabase", "ci", "payments", "shared"],
  "memoryLimits": { "factsPerArea": 30, "openQuestionsPerArea": 10 },
  "verify": {
    "commands": [
      { "id": "typecheck", "run": "pnpm --filter @sync/web typecheck" },
      { "id": "test", "run": "pnpm --filter @sync/web test" }
    ],
    "screenshotDir": "apps/web/tests/e2e/__screenshots__"
  }
}
